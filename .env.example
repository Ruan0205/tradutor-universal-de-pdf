# Runtime
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8050
BASE_DIR=/data
DATABASE_URL=postgresql+psycopg://translator:translator@postgres:5432/translator
REDIS_URL=redis://redis:6379/0

# Security
AUTH_ENABLED=true
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/initial_admin_password

# Translation
SOURCE_LANG=English
TARGET_LANG=Português Brasileiro
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_BASE_URL=http://ollama:11434
LLM_CONTEXT_SIZE=
LLM_MAX_OUTPUT_TOKENS=
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
LLM_REASONING_MODE=off

# OCR
OCR_PROVIDER=auto
OCR_CONFIDENCE_THRESHOLD=0.88
OCR_RENDER_DPI=300

# Optional Google integration. Disabled by default.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_OCR_PROVIDER=document-ai
GOOGLE_TRANSLATION_PROVIDER=cloud-translation
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_credentials
GOOGLE_MAX_PAGES_PER_JOB=0
GOOGLE_MONTHLY_BUDGET_LIMIT=0
GOOGLE_FALLBACK_TO_LOCAL=true

# Queue/resources
MAX_CONCURRENT_BOOKS=1
MAX_CONCURRENT_PAGES=
MAX_OCR_WORKERS=
MAX_RENDER_WORKERS=
MAX_LLM_REQUESTS=
MAX_MEMORY_PERCENT=85
MIN_FREE_DISK_GB=20

# Storage
INPUT_DIR=/data/input
WORK_DIR=/data/work
OUTPUT_DIR=/data/output
ORIGINALS_DIR=/data/originals
REPORTS_DIR=/data/reports
BACKUP_DIR=/data/backups

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
